{
  "name": "diligence-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Diligence Live: supervised investment diligence workspace with adaptive expert interviews over Higgs realtime voice",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch backend/src/index.ts\" \"vite\"",
    "build": "npm run typecheck && vite build && esbuild backend/src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=backend/dist/server.js",
    "start": "node backend/dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p frontend/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "tsx tests/e2e/browser-journey.ts",
    "test:browser-voice": "tsx tests/e2e/browser-voice.ts",
    "db:migrate": "tsx backend/scripts/migrate.ts",
    "demo:seed": "tsx backend/scripts/seed.ts",
    "demo:reset": "tsx backend/scripts/reset.ts",
    "build:fixtures": "tsx backend/scripts/build-fixtures.ts",
    "probe:live": "tsx backend/scripts/probe-live.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.3",
    "docx": "^9.14.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.2",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
