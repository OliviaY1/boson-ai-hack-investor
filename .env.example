# Copy to .env (gitignored). Every value here is read by the backend only; nothing is sent to the browser.

# --- Server ---------------------------------------------------------------------------------------
# Loopback by default. Binding beyond loopback without ACCESS_TOKEN logs a warning.
HOST=127.0.0.1
PORT=8787
# Persistent SQLite database and uploaded source files. Survives restarts; never reset on startup.
DATA_DIR=./data
# Browser origins allowed to open WebSockets (the backend's own origin is always allowed).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Basic consultant access control. When set, consultant APIs and the copilot WebSocket require this token
# (entered once on the sign-in screen, then kept in an HttpOnly cookie). Participant links never need it.
ACCESS_TOKEN=

# --- Reasoning provider (planner, interview controller, text copilot) ----------------------------------
# Without ANTHROPIC_API_KEY the deterministic mock is used and labelled as such in the UI.
ANTHROPIC_API_KEY=
# Alternatively read the key from a file:
# ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic
REASONING_MODEL=claude-opus-5-5
# "default" enables server-side model fallbacks for supported models; set to "off" to disable.
REASONING_FALLBACKS=default
PROVIDER_TIMEOUT_MS=45000

# --- Higgs realtime voice (expert interviews and the private voice copilot) -----------------------------
BOSON_API_KEY=
# BOSON_API_KEY_FILE=/run/secrets/boson
BOSON_REALTIME_URL=wss://api.boson.ai/v1/realtime?model=higgs-realtime
BOSON_MODEL=higgs-realtime
BOSON_VOICE=default
BOSON_TRANSCRIPTION_MODEL=higgs-stt-3.1
# How long to wait for a committed turn's final transcription before treating it as missing.
TRANSCRIPTION_TIMEOUT_MS=12000
# Allow the clearly labelled "live Higgs voice + deterministic mock reasoning" interview mode.
ALLOW_LIVE_VOICE_MOCK_REASONING=false

# Terminal timeline of each call: on (steps and timings), verbose (also transcript text), off.
CALL_TRACE=on

# --- Limits ---------------------------------------------------------------------------------------
JOIN_TOKEN_TTL_MINUTES=120
MAX_UPLOAD_BYTES=5242880
# Set to false to stop the backend from serving the production frontend build (dist/web).
SERVE_STATIC=true
